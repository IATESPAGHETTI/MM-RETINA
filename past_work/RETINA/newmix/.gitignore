# patient / hospital data: never publish.
# Anchored to this folder: an unanchored "data/" also matched the source directory
# frontend/src/app/workspace/data/, so that page was never committed and the sidebar's
# "Data & integrity" link 404'd in every fresh checkout.
/data/

# real patient scans copied from the Sankara cohort (keep samples.json numbers only)
frontend/public/samples/oct-*.jpg

# model weights and caches (too large for GitHub; see README "Getting the data and weights")
models/*.pt
models/*.joblib
ml/gamma/checkpoints/
backend/dipp/models/
backend/dipp/saved_model/
ml/results/paper/pre512.npy
ml/results/explore/*.npy
