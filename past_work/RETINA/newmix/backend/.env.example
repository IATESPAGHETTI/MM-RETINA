# Copy to backend/.env (git-ignored) and fill in. Never commit the real file.
# Without a key, POST /api/explain falls back to a built-in template explanation.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Optional
# SUITE_DB_PATH=../var/suite.db
# CORS_ORIGINS=http://localhost:3000,http://localhost:3100
